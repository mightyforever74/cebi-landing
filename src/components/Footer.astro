---
import site from '../content/site';

const link = 'text-navy-fog transition hover:text-offwhite';
---

<footer class="mt-24 border-t border-navy-line bg-navy-ink">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-3 md:gap-16">
    <div class="md:col-span-1">
      <p class="font-display text-lg font-bold text-offwhite">Cebi</p>
      <p class="mt-3 max-w-sm text-sm font-medium leading-relaxed text-navy-fog">{site.footer.tagline}</p>
      <p class="mt-6 text-sm">
        <a class={link} href={`mailto:${site.demoCta.email}`}>{site.demoCta.email}</a>
      </p>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{site.footer.product}</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li>
          <a class={link} href="#features">{site.footer.features}</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{site.footer.contact}</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li>
          <a class={link} href="#contact">{site.footer.contact}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-line px-4 py-8 text-center text-xs font-medium text-navy-fog sm:px-6">
    {site.footer.copyright} — {site.footer.rights}
  </div>
</footer>
