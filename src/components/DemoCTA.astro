---
import site from '../content/site';

const c = site.demoCta;
const mailto = `mailto:${c.email}?subject=${encodeURIComponent(c.mailtoSubject)}`;
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:py-32">
  <div class="glass relative overflow-hidden rounded-3xl px-6 py-16 text-center sm:px-12">
    <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-accent/20 blur-3xl" />
    <h2 class="font-display text-3xl font-bold tracking-tight text-offwhite sm:text-4xl lg:text-5xl">{c.title}</h2>
    <p class="mx-auto mt-6 max-w-[65ch] text-lg font-medium leading-relaxed text-navy-fog lg:text-xl">{c.body}</p>
    <a href={mailto} class="btn-primary mt-10 inline-flex whitespace-nowrap">{c.button}</a>
    <p class="mt-4 text-sm font-medium text-navy-fog">
      {c.orCall} <a class="text-accent-soft transition hover:text-accent" href={mailto}>{c.email}</a>
    </p>
  </div>
</section>
