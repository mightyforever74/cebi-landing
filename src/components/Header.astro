---
import site from '../content/site';

const navLink = 'text-sm font-medium text-navy-fog transition hover:text-offwhite';
---

<header class="site-header glass sticky top-0 z-50 h-16">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <div class="flex min-w-0 items-center gap-1.5 sm:gap-2">
      <details class="relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl text-offwhite transition hover:bg-white/5 [&::-webkit-details-marker]:hidden"
          aria-label={site.nav.menu}
        >
          <span class="sr-only">{site.nav.menu}</span>
          <span class="flex flex-col gap-1" aria-hidden="true">
            <span class="h-0.5 w-4 rounded-full bg-offwhite"></span>
            <span class="h-0.5 w-4 rounded-full bg-offwhite"></span>
            <span class="h-0.5 w-3 rounded-full bg-offwhite"></span>
          </span>
        </summary>
        <nav class="glass absolute left-0 top-[calc(100%+0.5rem)] z-50 min-w-[13rem] rounded-xl p-2 shadow-nav" aria-label={site.nav.menu}>
          <a href="#features" class="block rounded-lg px-3 py-2 text-sm font-medium text-navy-fog hover:bg-white/5 hover:text-offwhite">
            {site.nav.features}
          </a>
        </nav>
      </details>

      <a href="/" class="font-display truncate text-xl font-bold tracking-tight text-offwhite">
        Cebi
      </a>
    </div>

    <nav class="hidden items-center gap-6 lg:flex" aria-label={site.nav.primaryAria}>
      <a href="#features" class={navLink}>{site.nav.features}</a>
    </nav>
  </div>
</header>
